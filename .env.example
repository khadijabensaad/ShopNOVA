# Copié en .env par : python setup_flags.py (qui génère aussi des flags aléatoires)
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
SECURE_MODE=false
# Mot de passe des comptes de la plateforme SecOps (admin, agent, llm, rag, blue, auditor). Généré par setup_flags.py.
PLATFORM_PASSWORD=
FLAG_SYSTEM_PROMPT=
FLAG_INTERNAL_CODE=
FLAG_REVIEW_INJECTION=
FLAG_CUSTOMER_DATA=
FLAG_MCP_NOAUTH=
FLAG_AGENT_REFUND=
FLAG_AGENT_EMAIL=
FLAG_AGENT_MEMORY=
FLAG_MCP_NOTICE=
FLAG_AGENT_SECURE=
